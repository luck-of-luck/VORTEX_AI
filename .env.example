# =====================================================================
#  VORTEX_AI - Hermes Agent | variaveis de ambiente
#
#  Copie para ".env" (o setup.ps1 faz isso automaticamente) e preencha.
#  HERMES_HOME normalmente aponta para a raiz deste repositorio.
# =====================================================================

# Caminho da raiz do agente (normalmente o diretorio deste repositorio)
HERMES_HOME=

# ---- Provedores de modelo (pelo menos UM e necessario) ----
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Plataformas de mensagens (opcional - gateway) ----
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# ---- Extras / outros provedores ----
COPILOT_GITHUB_TOKEN=
OPENCODE_ZEN_API_KEY=
CLINE_API_KEY=

# ---- Cline (models gratuitos / baixo custo) ----
# Crie sua conta/API key em https://app.cline.bot (Settings > API Keys).
# Modelos: minimax/minimax-m2.5 (experimentação gratuita), deepseek/deepseek-chat,
# e os do ClinePass (assinatura $9.99/mês): cline-pass/deepseek-v4-flash,
# cline-pass/qwen3.7-plus, cline-pass/glm-5.2. Já configurados em config.yaml.

# ---- n8n (automacao de workflows via MCP) ----
# Instale o bridge com: hermes mcp install n8n
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=

# ---- Navegador - providers cloud OPCIONAIS ----
# Sem chave, o Hermes usa o Chrome/Edge local automaticamente.
# BROWSER_USE_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# ---- Outras IAs do PC (opcionais; cada uma entra na cadeia de fallback) ----
# Claude / Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub Copilot / GitHub Models (use o token do GitHub)
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=

# Kimi / Moonshot
# KIMI_API_KEY=

# ---- Modelos locais gratuitos (Ollama) ----
# Instale em https://ollama.io e baixe modelos (ex.: ollama pull qwen2.5-coder:32b).
# O provider "ollama-local" ja esta configurado em config.yaml.
# OLLAMA_URL=http://127.0.0.1:11434

# ---- LM Studio (app desktop com servidor local OpenAI-compativel) ----
# Abra o app -> aba Developer -> "Start Server" (porta 1234).
# Informe abaixo um modelo que voce instalou (ou deixe e ajuste em config.yaml):
# LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct
# O provider "lmstudio-local" ja esta em config.yaml -> http://127.0.0.1:1234/v1