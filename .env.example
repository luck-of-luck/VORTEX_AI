# =====================================================================
#  VORTEX_AI - Hermes Agent | variaveis de ambiente
#
#  Copie para ".env" (o setup.ps1 faz isso automaticamente) e preencha.
#  HERMES_HOME normalmente aponta para a raiz deste repositorio.
# =====================================================================

# Caminho da raiz do agente (normalmente o diretorio deste repositorio)
HERMES_HOME=

# ---- Provedores de modelo (pelo menos UM e necessario) ----
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Plataformas de mensagens (opcional - gateway) ----
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# ---- Extras / outros provedores ----
COPILOT_GITHUB_TOKEN=
OPENCODE_ZEN_API_KEY=
CLINE_API_KEY=