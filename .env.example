# =====================================================================
#  VORTEX_AI - Hermes Agent | variaveis de ambiente
#
#  SETUP AUTOMATICO: o setup.bat / setup.ps1 cria o .env sozinho
#  a partir deste arquivo. Voce so precisa preencher PELO MENOS UMA
#  chave abaixo e salvar. O fallback inteligente troca sozinho se
#  a chave falhar (429/quota) ou se estiver vazia.
#
#  Fluxo "clone & use":
#    1) git clone https://github.com/luck-of-luck/VORTEX_AI.git
#    2) setup.bat  (duplo-clique)
#    3) edite .env -> preencha 1 chave -> salve -> Abrir-Hermes.bat
#
#  HERMES_HOME = pasta raiz do repo. Deixe vazio que o setup preenche.
# =====================================================================

# Caminho da raiz do agente (normalmente o diretorio deste repositorio)
# Deixe vazio ou aponte para a pasta clonada. Ex: C:\Users\voce\VORTEX_AI
HERMES_HOME=

# =====================================================================
#  PROVEDORES DE MODELO  (preencha PELO MENOS UM - 1 ja basta!)
#  Ordem de fallback configurada em config.yaml (troca automatica):
#    Cline (gratis) -> ClinePass -> Copilot -> Claude -> Kimi
#    -> OpenRouter :free -> LM Studio local -> Ollama local (offline)
# =====================================================================

# ---- RECOMENDADO: Cline (gratis / experimentacao) ----
# Crie em https://app.cline.bot -> Settings > API Keys (free tier)
# Modelos ja configurados: minimax/m2.5 (principal), deepseek-chat, etc.
CLINE_API_KEY=

# ---- OpenRouter (gratis :free) - otima alternativa ----
# Crie em https://openrouter.ai/keys  (modelos :free sem cartao)
# Ex: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b:free
OPENROUTER_API_KEY=

# ---- Anthropic / OpenAI (pagos, opcional) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- GitHub Copilot / GitHub Models (se voce tem Copilot) ----
# Use seu Personal Access Token do GitHub com escopo copilot
COPILOT_GITHUB_TOKEN=
GH_TOKEN=
GITHUB_TOKEN=

# ---- Kimi / Moonshot (alternativa barata) ----
KIMI_API_KEY=

# ---- OpenCode Zen (opcional, para opencode) ----
OPENCODE_ZEN_API_KEY=

# =====================================================================
#  MODELOS LOCAIS 100% GRATIS / OFFLINE (sem chave, sem internet apos baixar)
#  Ja configurados em config.yaml como ultimo fallback.
#  Basta instalar o app e baixar um modelo:
# =====================================================================

# ---- Ollama (https://ollama.com) - RECOMENDADO para offline ----
# Depois de instalar:  ollama pull qwen2.5-coder:32b
# Para PCs modestos:   ollama pull qwen2.5:14b
# Iniciar servidor:    ollama serve  (geralmente ja inicia sozinho)
# Provider ja em config.yaml: ollama-local -> http://127.0.0.1:11434/v1
# OLLAMA_URL=http://127.0.0.1:11434

# ---- LM Studio (https://lmstudio.ai) - alternativa desktop ----
# Abra o app -> aba Developer -> "Start Server" (porta 1234)
# Modelos aparecem em http://127.0.0.1:1234/v1/models
# Provider ja em config.yaml: lmstudio-local -> http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct

# =====================================================================
#  PLATAFORMAS DE MENSAGENS (opcional - so se usar gateway)
#  Configure depois com: hermes gateway setup
# =====================================================================
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=

# =====================================================================
#  AUTOMACOES (opcional)
# =====================================================================

# ---- n8n (workflows) ----
# Instale o bridge: hermes mcp install n8n  (ou setup.ps1 -WithN8nMCP)
# Gere API key em n8n -> Settings -> API
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=

# ---- Navegador - providers cloud OPCIONAIS ----
# Sem chave, o Hermes usa Chrome/Edge local automaticamente (gratis).
# So preencha se quiser usar Browser Use / Browserbase na nuvem:
# BROWSER_USE_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
