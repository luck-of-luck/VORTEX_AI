{
  "$schema": "https://opencode.ai/config.json",
  "model": "cline/minimax/minimax-m2.5",
  "small_model": "cline/deepseek/deepseek-chat",
  "instructions": ["AGENTS.md", "docs/**/*.md"],
  "references": {
    "hermes-docs": {
      "path": "./docs",
      "description": "Hermes architecture, gateway, plugins"
    },
    "hermes-skills": {
      "path": "./skills",
      "description": "Built-in Hermes skills catalog"
    }
  },
  "mcp": {
    "hermes": {
      "type": "local",
      "command": ["../bin/hermes.exe", "mcp", "serve"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "provider": {
    "openrouter": {},
    "cline": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "minimax/minimax-m2.5": {
          "name": "MiniMax M2.5 (grátis/experimentação)"
        },
        "deepseek/deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "cline-pass/deepseek-v4-flash": {
          "name": "ClinePass DeepSeek V4 Flash"
        },
        "cline-pass/qwen3.7-plus": {
          "name": "ClinePass Qwen3.7 Plus"
        },
        "cline-pass/glm-5.2": {
          "name": "ClinePass GLM-5.2"
        }
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf /*": "deny",
      "git push --force *": "deny",
      "*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15,
    "preserve_recent_tokens": 25000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 100000
  }
}
