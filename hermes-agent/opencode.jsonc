{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-opus-4-5",
  "small_model": "opencode/claude-haiku-4-5",
  "instructions": ["AGENTS.md", "docs/**/*.md"],
  "references": {
    "hermes-docs": {
      "path": "./docs",
      "description": "Hermes architecture, gateway, plugins"
    },
    "hermes-skills": {
      "path": "./skills",
      "description": "Built-in Hermes skills catalog"
    }
  },
  "mcp": {
    "hermes": {
      "type": "local",
      "command": ["../bin/hermes.exe", "mcp", "serve"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "provider": {
    "openrouter": {},
    "github-copilot": {}
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf /*": "deny",
      "git push --force *": "deny",
      "*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15,
    "preserve_recent_tokens": 25000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 100000
  }
}
